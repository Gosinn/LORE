{
  "appId": "com.gosinn.lore",
  "appName": "LORE",
  "webDir": "apps/web/dist",
  "android": {
    "path": "apps/android"
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#f4eee3",
      "showSpinner": false
    },
    "CapacitorUpdater": {
      "autoUpdate": "off",
      "updateUrl": "",
      "channelUrl": "",
      "statsUrl": "",
      "appReadyTimeout": 10000,
      "autoDeleteFailed": true,
      "autoDeletePrevious": true,
      "resetWhenUpdate": true
    }
  }
}
