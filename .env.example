# Copy to .env and adjust. Every variable is optional in development.

# --- Database -----------------------------------------------------------------
# Production: a Postgres connection string. Development: leave unset to use the
# embedded PGlite database stored in .data/pglite.
# DATABASE_URL=postgres://lore:secret@localhost:5432/lore
# PGLITE_DIR=.data/pglite

# --- Server -------------------------------------------------------------------
# HOST=127.0.0.1
# PORT=4000
# LOG_LEVEL=info
# Browser origins allowed to make signed-in writes (comma separated).
# WEB_ORIGINS=http://localhost:5173
# Behind a reverse proxy (so the API sees the real https origin):
# TRUST_PROXY=true
# COOKIE_SECURE=true
# SESSION_DAYS=60

# --- Files --------------------------------------------------------------------
# Where uploaded photos are stored.
# MEDIA_DIR=.data/media
# Built web app served by the API in single-server deploys.
# PUBLIC_DIR=apps/web/dist

# --- The Loracle (wishes) ------------------------------------------------------
# The stone's mind is Claude (Anthropic). Without a key the stone sleeps and the
# rest of LORE works as before. Never commit a real key.
# ANTHROPIC_API_KEY=
# The owner's monthly spend ceiling in US$; past it, wishes wait for the new moon.
# LORACLE_MONTHLY_USD=150
# The dawn lane (phase B): a long random secret (24+ characters) for POST /api/loracle/tick, sent
# hourly by .github/workflows/loracle-tick.yml. Unset: the dawn lane is off and the tick is a 404.
# LORACLE_TICK_SECRET=
# The stone's soft budget, never shown: casts ("Ask again" included) and deeper asks a Lorer gets
# drawn at once per local day, and US$ a UTC day across everyone. Past them, work waits for dawn
# (Message Batches, half price). Only while the dawn lane is on.
# LORACLE_CASTS_NOW=3
# LORACLE_DEEPER_NOW=10
# LORACLE_DAILY_BUDGET_USD=10
# Development only: a deterministic fake mind (no network, no cost, canned quests).
# LORACLE_MIND=fake

# --- The owner (moderation and live text) ----------------------------------------
# Who may moderate and change LORE's words in the app (comma separated usernames).
# Unset: the owner is the account `gosinn` created before 19 November 2026 (in
# development on the embedded database, any `gosinn`). Set but empty: nobody.
# ADMIN_USERNAMES=gosinn
# Live text kill switch: `off` shows the code's own words everywhere and refuses
# to publish edits (they stay stored; switch back on to show them again). Read
# leniently: unset, empty, on/true/1/yes mean on; anything else (OFF, false, 0) is off.
# COPY_OVERRIDES=on

# --- docker-compose ------------------------------------------------------------
# POSTGRES_PASSWORD=change-me
# PUBLIC_URL=https://lore.example.com
