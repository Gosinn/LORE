# Copy to .env and adjust. Every variable is optional in development.

# --- Database -----------------------------------------------------------------
# Production: a Postgres connection string. Development: leave unset to use the
# embedded PGlite database stored in .data/pglite.
# DATABASE_URL=postgres://lore:secret@localhost:5432/lore
# PGLITE_DIR=.data/pglite

# --- Server -------------------------------------------------------------------
# HOST=127.0.0.1
# PORT=4000
# LOG_LEVEL=info
# Browser origins allowed to make signed-in writes (comma separated).
# WEB_ORIGINS=http://localhost:5173
# Behind a reverse proxy (so the API sees the real https origin):
# TRUST_PROXY=true
# COOKIE_SECURE=true
# SESSION_DAYS=60

# --- Files --------------------------------------------------------------------
# Where uploaded photos are stored.
# MEDIA_DIR=.data/media
# Built web app served by the API in single-server deploys.
# PUBLIC_DIR=apps/web/dist

# --- docker-compose ------------------------------------------------------------
# POSTGRES_PASSWORD=change-me
# PUBLIC_URL=https://lore.example.com
